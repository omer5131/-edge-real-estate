{
  "name": "edge-real-estate-intelligence",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node reconstruct.mjs && node scripts/inject-neighborhood-ui.mjs && vite",
    "build": "node reconstruct.mjs && node scripts/inject-neighborhood-ui.mjs && tsc -b && tsc -p tsconfig.server.json --noEmit false --outDir .server-build && vite build && node scripts/migrate-over.mjs && node scripts/migrate-yad2.mjs && node scripts/migrate-research.mjs && node scripts/migrate-area-intelligence.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "backfill:over": "node scripts/over-backfill.mjs",
    "check:server": "tsc -p tsconfig.server.json",
    "migrate:areas": "node scripts/migrate-area-intelligence.mjs",
    "test:areas": "tsc -p tsconfig.server.json --noEmit false --outDir .server-test && node --test tests/area-scoring.test.mjs",
    "test:over": "tsc -p tsconfig.server.json --noEmit false --outDir .server-test && node --test tests/over-api.test.mjs",
    "sync:yad2": "tsc -p tsconfig.server.json --noEmit false --outDir .server-build && node scripts/yad2-sync.mjs",
    "test:yad2": "tsc -p tsconfig.server.json --noEmit false --outDir .server-test && node --test tests/yad2.test.mjs tests/yad2-pipeline.test.mjs tests/yad2-location.test.mjs",
    "test:research": "tsc -p tsconfig.server.json --noEmit false --outDir .server-test && node --test tests/research.test.mjs",
    "collect:yad2": "tsc -p tsconfig.server.json --noEmit false --outDir .server-build && node scripts/yad2-collect.mjs",
    "process:yad2": "tsc -p tsconfig.server.json --noEmit false --outDir .server-build && node scripts/yad2-process.mjs",
    "import:cbs-neighborhoods": "node scripts/import-cbs-neighborhood-key.mjs",
    "eval:neighborhood": "tsc -p tsconfig.server.json --noEmit false --outDir .server-eval && node scripts/run-neighborhood-evals.mjs",
    "eval:neighborhood:agent": "tsc -p tsconfig.server.json --noEmit false --outDir .server-eval && node scripts/run-neighborhood-evals.mjs --agent",
    "audit:phase0": "node scripts/phase0-audit.mjs",
    "report:cbs-crosswalk": "node scripts/cbs-crosswalk-report.mjs",
    "test:phase1": "tsc -p tsconfig.server.json --noEmit false --outDir .server-test && node --test tests/phase1-context.test.mjs",
    "test:phase3": "tsc -p tsconfig.server.json --noEmit false --outDir .server-test && node --test tests/deal-engine.test.mjs tests/phase1-context.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "pgsql-ast-parser": "^12.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vercel/node": "^5.3.24",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
